# Copy to .env.local and fill in.

# Required for AI video analysis. Without it the app falls back to a
# deterministic offline estimator so the rest of the workflow still works.
ANTHROPIC_API_KEY=

# Model used to read the survey keyframes + narration transcript.
ANTHROPIC_MODEL=claude-opus-5

# Where survey videos and the SQLite database are written.
# Defaults to ./data
REMOVALS_SURVEY_DATA_DIR=

# Public base URL, used to build the client capture link that gets sent out.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-side speech-to-text for survey narration. Optional but strongly
# recommended: the browser's own speech recognition only works on some
# browsers, so without this a share of your surveys arrive with no transcript.
# Speaks the OpenAI audio-transcriptions API, which Whisper-compatible
# services (OpenAI, Groq, self-hosted whisper.cpp) all implement.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=en

# --- Supabase (optional) -------------------------------------------------
# Set these and the app switches from local SQLite + disk to Postgres, auth
# and object storage. Leave them blank to run entirely locally with no
# accounts, which is what `npm run dev` expects.
#
# Apply supabase/migrations/*.sql to the project first, then create a company
# row and point your user's profile at it — see the README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; needed for customer capture links
# (which have no session) and for video storage. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=survey-videos
