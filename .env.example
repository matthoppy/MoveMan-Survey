# Copy to .env.local and fill in.

# Required for AI video analysis. Without it the app falls back to a
# deterministic offline estimator so the rest of the workflow still works.
ANTHROPIC_API_KEY=

# Model used to read the survey keyframes + narration transcript.
# Sonnet is the default: roughly half the cost of Opus and good at this task.
# Switch to claude-opus-5 if it starts missing items in cluttered rooms — each
# survey records which model produced it, so you can compare on one recording.
ANTHROPIC_MODEL=claude-sonnet-5

# Where survey videos and the SQLite database are written.
# Defaults to ./data
REMOVALS_SURVEY_DATA_DIR=

# Public base URL, used to build the client capture link that gets sent out.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- The customer-facing notice ------------------------------------------
# Named in the recording notice the customer agrees to before filming, and in
# the privacy notice at /privacy. Both are shown to real customers, so a
# privacy notice that cannot name who holds the footage or where to write to
# have it deleted is not fit to show anyone — the page says so until these
# are set.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=

# How long survey videos are kept before the purge deletes them. The customer
# is told this number, so changing it changes what they were promised.
# Defaults to 90 days.
VIDEO_RETENTION_DAYS=90

# Shared secret for POST /api/retention/purge, which a scheduler calls daily.
# Unset means the purge is disabled and refuses to run — an endpoint that
# deletes customer footage is not something to leave open by default.
#   curl -fsS -X POST https://your-app/api/retention/purge \
#        -H "authorization: Bearer $RETENTION_PURGE_TOKEN"
RETENTION_PURGE_TOKEN=

# Server-side speech-to-text for survey narration. Optional but strongly
# recommended: the browser's own speech recognition only works on some
# browsers, so without this a share of your surveys arrive with no transcript.
# Speaks the OpenAI audio-transcriptions API, which Whisper-compatible
# services (OpenAI, Groq, self-hosted whisper.cpp) all implement.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=en

# --- Supabase (optional) -------------------------------------------------
# Set these and the app switches from local SQLite + disk to Postgres, auth
# and object storage. Leave them blank to run entirely locally with no
# accounts, which is what `npm run dev` expects.
#
# Apply supabase/migrations/*.sql to the project first, then create a company
# row and point your user's profile at it — see the README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; needed for video storage and the
# retention purge. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=survey-videos

# Where finished videos are kept: "local" or "supabase".
#
#   local     — on the server's disk. The app already needs a persistent volume
#               for staging chunks while a customer films, so this adds no new
#               requirement and has no size ceiling beyond the volume.
#   supabase  — in a private bucket, which survives the server being rebuilt.
#               But a Supabase project caps how big one object can be, by plan:
#               50 MB on the free plan, which is under three minutes of phone
#               video. A survey that exceeds it fails at the end of the upload,
#               after the customer has finished filming.
#
# Left unset it uses supabase when a service-role key is present, local
# otherwise — which is what older deployments did.
VIDEO_STORAGE=
